---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getProjectsSorted,
  getPublicationsSorted,
  aggregateTags,
} from "../../utils/content.ts";

const [projects, publications] = await Promise.all([
  getProjectsSorted(),
  getPublicationsSorted(),
]);
const tags = aggregateTags(projects, publications);
---

<BaseLayout title="Tags" description="Topics covered on this site.">
  <section class="section">
    <div class="container">
      <h1 class="section-title">Tags</h1>
      <ul class="tag-cloud">
        {
          tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}/`}>{tag.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

{
  "name": "nicm-dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Nic McDonald, built with Astro, TypeScript, and native CSS.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "astro sync && node --experimental-strip-types scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:suite": "node --experimental-strip-types scripts/test-cached.ts",
    "screenshots": "UPDATE_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

#!/bin/sh
# Pre-commit hook: run the full test suite before every commit.
# Mirrors CI: content validation, type check, unit tests, build, e2e tests.
# Uses the content-hash cache in scripts/test-cached.ts: steps whose input
# files are unchanged since their last passing run are skipped, so running
# `npm run test:suite` before committing makes this hook effectively instant.
# Enabled via `git config core.hooksPath .githooks` (see AGENTS.md).
# Bypass in an emergency with `git commit --no-verify`.

set -e

cd "$(git rev-parse --show-toplevel)"

node --experimental-strip-types scripts/test-cached.ts
